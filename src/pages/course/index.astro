---
const clubUrl = "https://app.koala-oss.club/";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${clubUrl}`} />
    <link rel="canonical" href={clubUrl} />
    <title>俱乐部视频</title>
    <script is:inline define:vars={{ clubUrl }}>
      window.location.replace(clubUrl);
    </script>
  </head>
  <body>
    <p>正在跳转到 <a href={clubUrl}>{clubUrl}</a> …</p>
  </body>
</html>
